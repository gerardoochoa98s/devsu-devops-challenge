# Application
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
APP_VERSION=local

# Database: sqlite (local default) or postgres (Docker/Kubernetes)
DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite
DB_LOGGING=false

# PostgreSQL settings (used when DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devops
DB_USER=devops
DB_PASSWORD=change-me
DB_SSL=false
