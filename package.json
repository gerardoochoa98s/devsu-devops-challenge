{
    "name": "demo-devops-nodejs",
    "version": "1.0.0",
    "private": true,
    "description": "DevOps technical test: containerized Node.js API deployed to Kubernetes with a CI/CD pipeline",
    "type": "module",
    "main": "index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "migrate": "node scripts/migrate.js",
        "migrate:down": "node scripts/migrate-down.js",
        "wait-for-db": "node scripts/wait-for-db.js",
        "coverage:summary": "node scripts/coverage-summary.js",
        "audit:prod": "npm audit --omit=dev --audit-level=high"
    },
    "dependencies": {
        "dotenv": "16.4.7",
        "express": "4.21.2",
        "helmet": "8.0.0",
        "pg": "8.13.1",
        "pg-hstore": "2.3.4",
        "sequelize": "6.37.5",
        "umzug": "3.8.2",
        "yup": "1.4.0"
    },
    "allowScripts": {
        "sqlite3": true
    },
    "devDependencies": {
        "@babel/core": "8.0.9",
        "@babel/preset-env": "8.0.7",
        "@eslint/js": "10.0.1",
        "babel-jest": "30.5.2",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "jest": "30.5.2",
        "jest-junit": "17.0.0",
        "prettier": "3.9.10",
        "sqlite3": "6.0.1",
        "supertest": "7.3.1"
    },
    "jest": {
        "testEnvironment": "node",
        "transform": {
            "^.+\\.js$": "babel-jest"
        },
        "setupFiles": [
            "<rootDir>/tests/setup.js"
        ],
        "collectCoverageFrom": [
            "app.js",
            "config.js",
            "users/**/*.js",
            "shared/**/*.js",
            "!shared/database/database.js"
        ],
        "coverageReporters": [
            "text",
            "lcov",
            "json-summary",
            "clover"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 85,
                "functions": 90,
                "lines": 90,
                "statements": 90
            }
        },
        "reporters": [
            "default",
            [
                "jest-junit",
                {
                    "outputDirectory": "reports",
                    "outputName": "junit.xml"
                }
            ]
        ]
    }
}
